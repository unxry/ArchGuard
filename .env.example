ARCHGUARD_APP_NAME="ArchGuard AI"
ARCHGUARD_ENVIRONMENT=development
ARCHGUARD_DEBUG=false
ARCHGUARD_DATABASE_URL=postgresql+psycopg://archguard:archguard-local-only@localhost:5432/archguard
ARCHGUARD_LOG_LEVEL=INFO
# Optional AI provider. Source upload also requires CLI --allow-remote-ai.
# ARCHGUARD_AI_PROVIDER=openai
# ARCHGUARD_AI_MODEL=your-structured-output-model
# ARCHGUARD_AI_API_KEY=your-api-key
# Public, local-development credentials only. Replace for a real deployment.
POSTGRES_DB=archguard
POSTGRES_USER=archguard
POSTGRES_PASSWORD=archguard-local-only
