@startuml
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 20
skinparam shadowing false
skinparam backgroundColor white
skinparam monochrome true
skinparam roundcorner 0
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 35
hide stereotype
rectangle "Публичный протокол и\ncommit" as N0
rectangle "Приватные case-данные" as N1
rectangle "Источник и ограниченный\nworker" as N2
rectangle "Фиксация предсказаний" as N3
rectangle "Разрешённое соединение с\ntruth" as N4
rectangle "Публичные агрегаты и\nSHA-256" as N5
N0 -right-> N1
N1 -right-> N2
N2 -down-> N3
N3 -left-> N4
N4 -left-> N5
legend bottom
Отпечаток связывает артефакты, но не доказывает истинность и авторство
endlegend
@enduml
