@startuml
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 20
skinparam shadowing false
skinparam backgroundColor white
skinparam monochrome true
skinparam roundcorner 0
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 35
hide stereotype
rectangle "Проспективный benchmark\n300" as N0
rectangle "Независимые рецензенты A\nи B" as N1
rectangle "290 совпадений, 10\nразногласий" as N2
rectangle "10 решений третьего\nчеловека" as N3
rectangle "Фиксация четырёх\nсостояний truth" as N4
rectangle "DEV 100 / FINAL 200" as N5
N0 -right-> N1
N1 -right-> N2
N2 -down-> N3
N3 -left-> N4
N4 -left-> N5
legend bottom
Intent конструирования не является truth; κ описывает согласие, а не точность
детектора
endlegend
@enduml
